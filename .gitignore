# ==========================================================
# HomeFix AI - .gitignore
# ==========================================================

# Secrets and Local Environment Files
.env
.env.local
.env.*.local
*.key
*.pem

# Uploaded Files & Attachments (Private Photos & Receipts)
uploads/
backend/uploads/
target/test-uploads/

# Maven & Java Build Outputs
target/
*.class
*.jar
*.war
*.ear
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup

# Node & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor Configurations
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs
*.log
logs/
backend/logs/

# Operating System Files
desktop.ini
$RECYCLE.BIN/
