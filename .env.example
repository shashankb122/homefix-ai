# ==========================================================
# HomeFix AI - Environment Configuration Example
# Copy to your local environment or set in IDE run configuration
# NEVER COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL
# ==========================================================

# 1. Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# 2. PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/homefix_ai
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# 3. JWT Security
# Must be a secure random key of at least 32 characters (256-bit)
JWT_SECRET=YourUltraSecureLongSecretKeyForJwtSigningMustBe32BytesMin!
JWT_EXPIRATION_MS=86400000

# 4. Google Gemini AI Vision & Diagnosis
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
# Leave blank to run the app in Offline/Unconfigured AI mode safely
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 5. File Uploads (Local development storage directory)
UPLOAD_DIR=uploads
